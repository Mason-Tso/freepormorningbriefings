# Anthropic Claude API (required for briefing generation)
ANTHROPIC_API_KEY=sk-ant-...

# Higgsfield.ai API (required for video generation)
HIGGSFIELD_API_KEY=...

# Optional: Polygon.io News API (adds premium news wire coverage)
POLYGON_API_KEY=...

# Optional: Twitter API v2 (for auto-posting to X)
TWITTER_BEARER_TOKEN=...
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_ACCESS_TOKEN=...
TWITTER_ACCESS_SECRET=...

# Optional: RSS feed overrides (JSON array of {url, name, weight} objects)
# RSS_FEEDS_JSON=[{"url":"https://feeds.example.com/rss","name":"Example","weight":2}]
